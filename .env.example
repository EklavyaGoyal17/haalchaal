# Copy to .env for local development. Never commit .env.
# Every variable from docs/SPEC.md §12 is listed; blank means "not set".

APP_ENV=dev
HTTP_ADDR=:8080
DATABASE_URL=postgres://haalchaal:haalchaal_dev@localhost:55432/haalchaal?sslmode=disable
TEST_DATABASE_URL=postgres://haalchaal:haalchaal_dev@localhost:55432/haalchaal_test?sslmode=disable

# <kid>:<base64 32-byte key>,... with kid 1-255. Generate with: make genkey
# Required outside dev. In dev, leave blank until code needs encryption.
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KID=
# email:bcrypt_hash,...
ADMIN_USERS=
# E.164, comma separated
ADMIN_ALERT_PHONES=

# Safety switches. Keep false unless you know exactly why.
CALLS_ENABLED=false
# Numbers that may be contacted outside production (E.164, comma separated)
DEV_ALLOWLIST=
# Set true only after legal sign-off on the calling number (SPEC §14)
TELECOM_COMPLIANCE_ACK=false

VOICE_PROVIDER=fake
VOICE_API_KEY=
VOICE_WEBHOOK_SECRET=
VOICE_AGENT_ID=
VOICE_FROM_NUMBER=

WHATSAPP_PROVIDER=fake
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=

LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=

RETRY_OFFSETS=15m,45m
ALERT_ACK_TIMEOUT=10m
URGENT_ACK_TIMEOUT=60m
FOLLOW_UP_TTL=168h
RETENTION_TRANSCRIPT_DAYS=365
RETENTION_AUDIT_DAYS=400
DEFAULT_TIMEZONE=Asia/Kolkata

# Concurrent job loops per worker process (1-64). Run more processes to scale out.
WORKER_CONCURRENCY=4
